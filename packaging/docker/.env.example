# Copy to .env in this folder (compose reads it from beside docker-compose.yml). .env is
# gitignored; this template is the only copy that belongs in the repository.

# --- hub --------------------------------------------------------------------------------
# Required. 32 random bytes, base64 — `openssl rand -base64 32`. Every stored credential is
# sealed with it; change it and everything sealed before shows as locked.
CONCENTUS_SECRET_KEY=

# Optional. The first account, for a hub nobody opens in a browser first. Both or neither.
CONCENTUS_ADMIN_EMAIL=
CONCENTUS_ADMIN_PASSWORD=

# --- runner -----------------------------------------------------------------------------
# From the hub: Resources → Runners → + New. Shown once; crn_ and forty characters.
CONCENTUS_RUNNER_TOKEN=
CONCENTUS_RUNNER_NAME=compose-runner

# The runner's Claude auth — YOURS, on infrastructure you operate. `claude setup-token` on a
# machine where you are logged in prints the first; the second is an API key. One of the two.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
