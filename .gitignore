# Java / Maven
apps/backend/target/
*.class

# The pgvector extension, compiled per platform by CI and staged into the jar's resources. Build
# output, not source: the source is pgvector's own repository, at the tag the workflows pin.
apps/backend/src/main/resources/pgvector/

# Node
node_modules/
apps/frontend/dist/
.pnpm-store/

# Playwright UI tests — reports and traces are build output
apps/frontend/playwright-report/
apps/frontend/test-results/

# Desktop shell — compiled output, installers, and the bundled payload the build stages
apps/desktop/dist/
apps/desktop/release/
apps/desktop/resources/

# App data (persisted flows)
data/
apps/backend/data/

# Secrets — .env.example is the tracked template
.env
.env.local
!.env.example

# Apple signing material (packaging/macos.md) — the key and certificate must NEVER enter git,
# wherever in the tree an openssl command happened to be run from.
developerid.*
DeveloperIDG2CA.cer
intermediate.pem
*.p12
*.p8

# Logs & OS
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
.claude/worktrees/
