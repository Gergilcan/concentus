<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.concentus</groupId>
    <artifactId>concentus-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>concentus-backend</name>
    <description>Spring Boot API for designing, running and steering YAML/flow-based Claude agents.</description>

    <properties>
        <java.version>25</java.version>
        <anthropic.version>2.34.0</anthropic.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <poi.version>5.4.1</poi.version>
        <jsoup.version>1.21.1</jsoup.version>
        <tess4j.version>5.16.0</tess4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- JDBC + connection pool for persisting runs/executions (PostgreSQL / Neon) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Sign-in, organizations and per-request org isolation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- IMAP, for the mail-triggered Input node. Brings the Jakarta Mail API and the Angus
             implementation, whose imap/imaps providers are what actually do the work — folders,
             SEARCH, flags and MOVE all live in the mail *store*, which is why this is IMAP and
             not SMTP. Version managed by the Boot parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Attachment text extraction. Pure Java, no native binaries: PDF, DOCX and XLSX are
             parsed in-process so the container image needs nothing extra for them. OCR is the
             one exception (see tess4j below). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- HTML mail bodies -> text, keeping tables and lists readable. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- OCR for image attachments and scanned PDFs. Unlike everything above, this is a JNA
             binding to the *native* Tesseract library: it is loaded lazily and the extractor
             reports itself unavailable when libtesseract or its language data is missing, so a
             deployment without them still starts and simply skips OCR. See apps/backend/Dockerfile. -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
            <exclusions>
                <!-- tess4j pulls its own logging bridge; Spring Boot already supplies one. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Official Anthropic Java SDK -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>

        <!-- YAML import/export of agent specs (jackson-databind comes from Spring) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- SQL RAG sources use plain JDBC (java.sql). PostgreSQL driver bundled by default;
             add another driver (e.g. mysql-connector-j) to support its jdbc: URLs. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Auto-restart the running app when classes recompile (dev only; excluded from the fat jar) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>concentus-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.concentus.ConcentusApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
