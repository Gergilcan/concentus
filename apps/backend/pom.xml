<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.concentus</groupId>
    <artifactId>concentus-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>concentus-backend</name>
    <description>Spring Boot API for designing, running and steering YAML/flow-based Claude agents.</description>

    <properties>
        <java.version>25</java.version>
        <anthropic.version>2.34.0</anthropic.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <poi.version>5.4.1</poi.version>
        <jsoup.version>1.21.1</jsoup.version>
        <embedded-postgres.version>2.1.0</embedded-postgres.version>
        <!--
            The PostgreSQL the app embeds. 17.5.0 is the newest zonky publishes — there is no 18,
            which is worth knowing before someone tries to raise it again.

            Changing the MAJOR version here is not just a number: a data directory initialised by
            one major cannot be read by another, so EmbeddedPostgresConfig checks the two agree and
            says so plainly rather than letting PostgreSQL fail with a lock-file-shaped error. Keep
            app.embedded-postgres.major-version in step with this.
        -->
        <embedded-postgres-binaries.version>17.5.0</embedded-postgres-binaries.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Tracing and metrics, spoken as OpenTelemetry.

             Micrometer is what the framework already instruments — HTTP requests, scheduled
             tasks, WebSocket sessions — and the OpenTelemetry bridge turns those observations
             into OTLP spans without any of that code knowing. What is added by hand is the part
             a generic instrumentation cannot see: a run, a block inside it, a worker, a tool
             call. See Telemetry.

             Exports nothing unless an endpoint is configured. A desktop install with no
             collector must not spend its evening retrying gRPC to localhost:4317. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <!-- A tracer that records into a list, so a test can read what a span actually said. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JDBC + connection pool for persisting runs/executions (PostgreSQL / Neon) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Sign-in, organizations and per-request org isolation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- IMAP, for the mail-triggered Input node. Brings the Jakarta Mail API and the Angus
             implementation, whose imap/imaps providers are what actually do the work — folders,
             SEARCH, flags and MOVE all live in the mail *store*, which is why this is IMAP and
             not SMTP. Version managed by the Boot parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Attachment text extraction. Pure Java, no native binaries: PDF, DOCX and XLSX are
             parsed in-process. OCR is not a dependency at all: ImageOcrExtractor runs the
             Tesseract PROGRAM when the machine has one (winget/brew/apt) and reports itself
             unavailable otherwise. tess4j used to be here — a JNA binding whose jar carried nine
             megabytes of Windows DLLs and an English model into every installer, and still needed
             libtesseract installed on the other platforms; the program is what people actually
             have, so that is what the app looks for. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
            <exclusions>
                <!-- pdfbox codes against the JCL API, which spring-jcl already provides; carrying
                     the real commons-logging too makes Spring log a discovery warning at startup. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- HTML mail bodies -> text, keeping tables and lists readable. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- Official Anthropic Java SDK -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>

        <!-- YAML import/export of agent specs (jackson-databind comes from Spring) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- SQL RAG sources use plain JDBC (java.sql). PostgreSQL driver bundled by default;
             add another driver (e.g. mysql-connector-j) to support its jdbc: URLs. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!--
            The database, embedded. Real PostgreSQL binaries extracted and started as a child
            process of the JVM against a data directory in the user's app-data folder — not an
            emulation, so the existing SQL (jsonb, upserts, partial indexes) runs unchanged and
            there is no dialect to port to.

            The binaries are platform-specific and are pulled in per platform below, which is what
            keeps each installer carrying only its own.

            One capability does not survive: pgvector is not part of these bundles, so the semantic
            ranking in ToolSearchIndex falls back to lexical matching. It already detects and logs
            that, so the behaviour is degraded rather than broken.
        -->
        <!--
            The built-in embedding runtime: ONNX Runtime executes the model, DJL's tokenizers
            wrap HuggingFace's native tokenizer. Both ship native libraries for win/linux/mac
            inside their jars, so nothing is installed at runtime — only the model itself is
            downloaded, on demand, from inside the app. This is what makes vector search work
            with no Ollama and no Docker.
        -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.30.0</version>
        </dependency>

        <!--
            Schema migrations. Versions are managed by the Spring Boot parent.

            flyway-database-postgresql is a separate artifact since Flyway 10 — without it Flyway
            starts and then reports PostgreSQL as unsupported, which reads like a configuration
            error rather than a missing dependency.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>${embedded-postgres.version}</version>
            <!--
                It ships every platform's binaries by default — Windows, macOS, Linux and Alpine,
                around 80MB of which at most one is ever executed. Excluded here and added back one
                at a time by the OS profiles below, so a Windows installer carries Windows
                PostgreSQL and nothing else.
            -->
            <exclusions>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Auto-restart the running app when classes recompile (dev only; excluded from the fat jar) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!--
        The PostgreSQL binaries for the platform being built on. Activated by the host OS, which is
        the correct rule for both cases that matter: a developer building locally gets binaries
        that run on their machine, and a per-platform CI runner produces an installer carrying its
        own. Nothing has to be passed on the command line for either.
    -->
    <profiles>
        <profile>
            <id>pg-binaries-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>pg-binaries-linux</id>
            <activation>
                <os><family>unix</family><name>linux</name></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <!--
            macOS splits by architecture where the others do not: the release builds on two mac
            runners (Apple Silicon and Intel), and zonky publishes a distinct artifact for each.
            Activation reads os.arch from the JVM running Maven — "aarch64" on an arm64 JDK,
            "x86_64" on Intel — which is the same rule as the OS split: binaries that run on the
            machine doing the building.
        -->
        <profile>
            <id>pg-binaries-mac-arm</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>pg-binaries-mac-intel</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <finalName>concentus-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.concentus.ConcentusApplication</mainClass>
                </configuration>
            </plugin>
            <!--
                onnxruntime loads its native library with System.load, which Java 24+ flags with a
                startup WARNING unless native access is granted. The manifest entry grants it for
                `java -jar`; the desktop shell passes the equivalent CLI flag because the manifest
                of the CDS-extracted layout is generated by the extract tool, not taken from here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
                The built frontend ships inside the jar, so the backend serves the UI from the same
                origin as the API. That is not a packaging convenience but the thing that removes a
                whole category of configuration: with /api, /ws and the page itself on one origin
                there is no proxy to configure, no CORS grant to keep in step, and the session and
                XSRF cookies are ordinary same-site cookies.

                The frontend has no client-side router, so Spring Boot's default handling of
                classpath:/static/ is all that is needed to serve it — no fallback controller.

                Build the frontend first (pnpm build). If dist/ is absent the plugin logs
                "skip non existing resourceDirectory" and the jar simply carries no UI, which is
                the right outcome for a backend-only test run rather than a build failure.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../frontend/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
