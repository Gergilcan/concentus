# Copy to .env and fill in real values. Never commit .env with real secrets.
#
# ============================================================================
# TO RUN WITH DOCKER COMPOSE, exactly four of these matter. The rest have working
# defaults, and every credential (mailboxes, Holded, GitHub/GitLab) is entered in
# the app instead — encrypted, never in a file.
#
#   CONCENTUS_SECRET_KEY      required, the backend will not start without it
#   CLAUDE_CODE_OAUTH_TOKEN   required, or no run can start
#   CONCENTUS_ADMIN_EMAIL     the account you sign in with
#   CONCENTUS_ADMIN_PASSWORD  min 12 chars; blank = generated and printed in the log
#
# `scripts/setup-env.sh` (or .ps1) writes a .env with the key already generated.
# ============================================================================

# --- Claude auth (docker-compose backend service) ---------------------------
# Subscription token from `claude setup-token` (NOT an API key). Preferred way to run
# the backend against your Claude subscription in docker-compose.
CLAUDE_CODE_OAUTH_TOKEN=

# Cloud (Managed Agents) API key. Set this instead of CLAUDE_CODE_OAUTH_TOKEN to run
# flows via Anthropic's hosted API rather than the local `claude` CLI.
ANTHROPIC_API_KEY=

# Execution mode: auto (default; key set -> cloud, else local) | local | api-key.
ANTHROPIC_AUTH_MODE=auto

# Alternative to ANTHROPIC_API_KEY understood by AnthropicClientProvider.
ANTHROPIC_AUTH_TOKEN=

# --- Run persistence (PostgreSQL) --------------------------------------------
# docker-compose ships a `db` service and wires these automatically; the value below is only
# the password it starts with. Change it, or leave it for local use.
# The backend creates its own schema, so an empty database is all that's needed.
PERSIST_DB_PASSWORD=concentus

# To use a hosted database (Neon, RDS, Cloud SQL) instead, remove the `db` service from
# docker-compose.yml and set all three:
# PERSIST_DB_URL=jdbc:postgresql://ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# PERSIST_DB_USER=neondb_owner
# PERSIST_DB_PASSWORD=...
# Set PERSIST_ENABLED=false to run without persistence (runs are lost on restart).

# --- Backend runtime (apps/backend/src/main/resources/application.properties) ---
# Directory where flows, run data, etc. are persisted.
APP_DATA_DIR=./data

# Path/name of the local `claude` CLI binary (blank = resolved from PATH).
CLAUDE_COMMAND=claude

# Permission mode passed to the local claude CLI executor.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Auto-register flow MCP nodes into `claude mcp add` (user scope) at run time.
LOCAL_AUTO_REGISTER_MCP=true

# Directories an agent's "Context folders" may point inside (comma-separated).
# Required: while this is empty every context folder is rejected, so a deployment
# that never opts in cannot be told to read arbitrary host paths.
# e.g. LOCAL_CONTEXT_ROOTS=C:\Users\me\code   (or /home/me/code)
LOCAL_CONTEXT_ROOTS=

# Directory for the reusable agent YAML library; blank = <APP_DATA_DIR>/agents.
APP_AGENTS_DIR=

# --- Sign-in and organizations -------------------------------------------------
# The API requires an authenticated session. Set AUTH_ENABLED=false only for local development;
# it leaves every endpoint open and resolves all requests to the default organization.
AUTH_ENABLED=true
APP_ORGANIZATION_ID=default
APP_ORGANIZATION_NAME=Concentus
# The administrator account. Provisioned at startup whenever THIS EMAIL has no account yet — not
# only on an empty database — so setting it after the first boot still works.
#
# Minimum 12 characters. That is the same rule that governs changing a password later, applied here
# too so an account is never created in a state from which its own password could not be re-set.
# Leave the password blank and one is generated and printed once in the backend log.
#
# This file is COMMITTED. Put real values in .env (which is gitignored), never here.
CONCENTUS_ADMIN_EMAIL=
CONCENTUS_ADMIN_PASSWORD=
# An existing account's password is NEVER overwritten from configuration — that would let anyone
# who can edit an environment variable take over a live account, and would silently undo a password
# changed in the app. Set this true for a single run to reset a genuinely lost one, then remove it.
CONCENTUS_ADMIN_PASSWORD_RESET=false

# Master key for credentials entered in the app (mailbox passwords, API tokens). They are encrypted
# with AES-256-GCM before being written, and no API ever returns one.
#
# What this buys, precisely: it protects a leaked database backup, a database-only compromise, or a
# read-only SQL injection. It does NOT protect against someone who compromises the server, since
# the key must be readable here to be usable — the secret collapses to this one key.
#
# REQUIRED: the backend refuses to start without it.
# Generate with: openssl rand -base64 32
# Changing it makes every stored credential unreadable; they have to be re-entered.
CONCENTUS_SECRET_KEY=


# --- Mail-triggered flows (IMAP) -----------------------------------------------
# An Input node in "mail" mode polls an IMAP folder and starts a run per matching message.
# IMAP, not SMTP: folders, flags and read state live in the mail store, so conditions like
# "flagged, in Presupuestos" — and moving the message once handled — only exist over IMAP.
#
# Host, username, folder and conditions are configured ON THE NODE, in the flow. The password is
# NOT: enter it in the app under Resources -> Credentials, where it is encrypted before storage
# (see CONCENTUS_SECRET_KEY above). The node stores only the credential id, so a flow can be
# exported, duplicated or rolled back without carrying a secret.
MAIL_TRIGGERS_ENABLED=true

# Microsoft 365: Basic authentication for IMAP was retired in Exchange Online, so a password is
# refused before it is even checked — a correct one still comes back as "AUTHENTICATE failed".
# Set the node's Authentication to "Microsoft 365 sign-in" and press Connect: it runs the OAuth2
# device code flow, which needs no redirect URI, no client secret and no browser on the server,
# so it works from inside the container. What gets stored is a refresh token, encrypted like any
# other credential, and it renews itself.
#
# The Entra app registration needs: delegated IMAP.AccessAsUser.All + offline_access, and
# Authentication -> "Allow public client flows" = Yes.
#
# Set its ids here, once. ONE registration serves every mailbox — it identifies the application,
# not the mailbox — so a node that leaves them blank uses these and nobody is asked again. A node
# can still override them under Advanced, for a deployment that talks to a second tenant.
# Neither is a secret: a public-client id is public by design and the tenant id is in every
# sign-in URL. The refresh token is the secret, and that one is encrypted in the credential store.
MAIL_MICROSOFT_TENANT_ID=
MAIL_MICROSOFT_CLIENT_ID=

# Gmail and self-hosted IMAP work with an app password, entered under Resources -> Credentials.

# --- Repository nodes (GitHub / GitLab) -----------------------------------------
# A repository node is cloned into the run's own working directory so the agent can edit it,
# commit, push a branch and open a PR/MR. The provider token is entered in the app under
# Resources -> Credentials and selected on the node; it is passed on the CLI process environment,
# never written into .git/config or a remote URL.
#
# A node can name a whole GitHub organization or GitLab group instead of one URL, in which case
# every repository inside it is cloned — resolved when the run starts, so a repository added to
# the group later is picked up without editing the flow. Individual repositories can still be
# ticked to narrow it down. This caps how many one node may expand to; going over is reported to
# the agent rather than silently truncated.
GIT_MAX_GROUP_REPOS=25
# 0 = full history. Shallow is faster but has awkward edges when pushing a new branch.
GIT_CLONE_DEPTH=0

# --- Attachment handling --------------------------------------------------------
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_TOTAL_BYTES=31457280
ATTACHMENT_MAX_COUNT=15
# OCR for image attachments and scanned PDFs. Needs the native tesseract library and language
# data, which the backend Dockerfile installs. Without them the extractor reports itself
# unavailable and images are skipped — the app still starts.
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
